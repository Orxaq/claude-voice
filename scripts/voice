#!/bin/bash
# voice — instant switch to voice conversation mode
#
# When run from inside Claude Code (non-interactive), opens a NEW Terminal
# window so audio I/O works. When run from a normal terminal, runs inline.
#
# Usage:
#   voice          → copilot (default)
#   voice coder    → pair programming partner
#   voice exec     → executive briefer
#   voice narrator → storyteller

set -euo pipefail

# Resolve symlinks to find the real script directory
REAL_PATH="$(readlink -f "$0" 2>/dev/null || python3 -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$0")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_PATH")" && pwd)"

# Pass-through flags like --help, --test directly
if [[ "${1:-}" == --* ]]; then
    exec python3 "$SCRIPT_DIR/voice_loop.py" "$@"
fi

PERSONA="${1:-copilot}"

# Map short names
case "$PERSONA" in
    exec|executive|brief) PERSONA="executive" ;;
    code|dev|pair) PERSONA="coder" ;;
    story|narrate) PERSONA="narrator" ;;
    default|claude) PERSONA="default" ;;
esac

EXTRA_ARGS="${@:2}"

# Detect if we're inside Claude Code's bash tool (non-interactive tty)
# or if audio output won't work (e.g., piped/redirected)
if [[ ! -t 0 ]] || [[ ! -t 1 ]] || [[ "${CLAUDE_CODE:-}" == "1" ]] || [[ "${TERM_PROGRAM:-}" != "Apple_Terminal" && "${TERM_PROGRAM:-}" != "iTerm.app" ]]; then
    # Launch in a NEW Terminal window so mic + speaker work
    osascript -e "
        tell application \"Terminal\"
            activate
            do script \"python3 $SCRIPT_DIR/voice_loop.py --persona $PERSONA $EXTRA_ARGS\"
        end tell
    " 2>/dev/null
    echo "Voice mode launched in Terminal window."
    exit 0
fi

# Normal terminal — run inline
exec python3 "$SCRIPT_DIR/voice_loop.py" --persona "$PERSONA" $EXTRA_ARGS
